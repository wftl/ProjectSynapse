[Unit]
Description=Add new Project Synapse episodes to the archive site commit and push
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Adjust if the repository lives elsewhere.
WorkingDirectory=/mnt/stff/AI/ProjectSynapse
Environment=SYNAPSE_BRANCH=master
Environment=GIT_SSH_COMMAND=ssh -o BatchMode=yes
ExecStart=/mnt/stff/AI/ProjectSynapse/deploy/run-update.sh
NoNewPrivileges=yes
TimeoutStartSec=30min
